model Advisor {
    advisor_id String @id @unique @default(uuid())

    user    User   @relation(fields: [user_id], references: [user_id])
    user_id String @unique

    profile_picture_path String

    animates           Animator[]
    appointments       Appointment[]       @relation("app_advisor")
    urgentAppointments UrgentAppointment[]

    assigned_job_seekers JobSeeker[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
