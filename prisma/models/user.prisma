/**
 * Table pour les utilisateurs
 */
model User {
    user_id String @id @unique @default(uuid())

    first_name String
    last_name  String
    email      String   @unique
    password   String
    phone      String   @db.Char(10)
    birth_date DateTime

    roleType RoleType

    administrator Administrator?
    advisor       Advisor?
    jobSeeker     JobSeeker?

    tokens Token[]

    receivedMessages Message[] @relation("receiver") // Messages reçus
    sendedMessages   Message[] @relation("sender") // Messages envoyés

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum RoleType {
    JOB_SEEKER
    ADVISOR
    ADMINISTRATOR
}
