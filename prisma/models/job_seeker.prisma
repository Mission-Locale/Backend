model JobSeeker {
    job_seeker_id String @id @unique @default(uuid())

    user    User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
    user_id String @unique

    assigned_advisor Advisor? @relation(fields: [assigned_advisor_id], references: [advisor_id])
    assigned_advisor_id String?

    appointments  Appointment[]  @relation("app_job_seeker")
    documents     Document[]
    registrations Registration[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
