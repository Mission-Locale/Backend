/**
 * Table pour les rdv
 */
model Appointment {
    appointment_id Int      @id @unique @default(autoincrement())

    startTime DateTime
    endTime   DateTime
    
    cancelled Boolean @default(false)

    advisor_id    String? // No advisor => Rendez-vous d'inscription
    advisor       Advisor?  @relation("app_advisor", fields: [advisor_id], references: [advisor_id])
    job_seeker_id String
    job_seeker    JobSeeker @relation("app_job_seeker", fields: [job_seeker_id], references: [job_seeker_id])

    appointmentResume AppointmentResume?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
