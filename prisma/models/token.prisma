/**
 * Tables pour les tokens (session, verification de mail, ...)
 */
model Token {
    token_id Int       @id @unique @default(autoincrement())
    token    String    @unique
    type     TokenType

    user_id String
    user    User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

    expiresAt DateTime

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum TokenType {
    REFRESH_TOKEN
    RESET_TOKEN
}
