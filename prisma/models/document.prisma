/**
 * Table pour les documents
 */
model Document {
    document_id Int @id @unique @default(autoincrement())

    type     DocumentType
    filename String

    job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [job_seeker_id], onDelete: Cascade)
    job_seeker_id String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum DocumentType {
    CNI
    JUSTIFICATION_DOMICILE
    PASSPORT
    PERMIS_DE_CONDUIRE
    REGISTER_FORM
    OTHER
}
