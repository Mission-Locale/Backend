# Main configuration
ENVIRONNEMENT="developpement"
HOST="localhost"
PORT=3000
DATABASE_URL="mysql://<username>:<password>@localhost:3306/mission-locale"
FRONTEND_URL="http://localhost:5173"

# Secrets
JWT_REFRESH_KEY="@n Secr3t key !"
JWT_ACCESS_KEY="@n Secr3t key !"
JWT_RESET_KEY="@n Secr3t key !"

# SMTP Configuration (Email)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-password"
SMTP_FROM="noreply@mission-locale.fr"

# Microsoft
MICROSOFT_APPLICATION_ID="1 Super id"
MICROSOFT_TENANT_ID="1 Autre super id"
MICROSOFT_SECRET="Ça fait beaucoup là non"
MICROSOFT_ACCOUNT="Petite cerise sur le gateau (c un mail)"